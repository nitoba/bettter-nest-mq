{
  "name": "better-nest-mq",
  "version": "0.0.0",
  "description": "NestJS-native module foundations for the better-effect-mq engine.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./dist/index.mjs"],
  "repository": { "type": "git", "url": "git+https://github.com/nitoba/bettter-nest-mq.git" },
  "homepage": "https://github.com/nitoba/bettter-nest-mq#readme",
  "bugs": { "url": "https://github.com/nitoba/bettter-nest-mq/issues" },
  "keywords": ["nestjs", "queue", "better-effect-mq", "typescript"],
  "files": ["dist", "LICENSE", "README.md", "CHANGELOG.md"],
  "exports": {
    ".": { "types": "./dist/index.d.mts", "import": "./dist/index.mjs" },
    "./package.json": "./package.json"
  },
  "engines": { "node": ">=22.12.0" },
  "packageManager": "bun@1.4.2",
  "devEngines": { "packageManager": { "name": "bun", "version": "1.4.2", "onFail": "error" } },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck:minimum": "node node_modules/typescript-minimum/bin/tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:package": "bun scripts/test-package.ts",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "check:tooling": "bun scripts/check-tooling.ts",
    "check": "bun run check:tooling && bun run typecheck && bun run typecheck:minimum && bun run test && bun run format:check && bun run lint && bun run build && bun run publint && bun run test:package",
    "hooks:install": "lefthook install",
    "prepublishOnly": "bun run check"
  },
  "peerDependencies": {
    "@nestjs/common": ">=12.0.0 <13.0.0",
    "@nestjs/core": ">=12.0.0 <13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": ">=6.0.0"
  },
  "peerDependenciesMeta": { "typescript": { "optional": true } },
  "devDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@oxlint/plugins": "1.78.0",
    "@standard-schema/spec": "^1.0.0",
    "@types/bun": "1.4.1",
    "@types/node": "^22.0.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.23",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "typescript-minimum": "npm:typescript@^6.0.0",
    "zod": "^4.0.0"
  },
  "trustedDependencies": ["lefthook"]
}
